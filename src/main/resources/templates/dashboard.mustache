<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>DEV HUNTER</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #08111f;
            color: #f8fafc;
            font-family: Arial, sans-serif;
        }

        .dashboard {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 220px;
            padding: 32px 24px;
            background: #0b1526;
            border-right: 1px solid #1e293b;
        }

        .sidebar h2 {
            margin: 0 0 40px 0;
            font-size: 24px;
            color: #38bdf8;
        }

        .sidebar nav {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .sidebar nav p {
            margin: 0;
            padding: 12px 14px;
            border-radius: 8px;
            color: #94a3b8;
        }

        .sidebar nav p:first-child {
            background: #162338;
            color: #38bdf8;
        }

        .main-content {
            flex: 1;
            padding: 40px;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
        }

        .top-header h1 {
            margin: 0;
            font-size: 36px;
            letter-spacing: 2px;
        }

        .top-header > div:first-child > p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 13px;
            letter-spacing: 2px;
        }

        .level-box {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .level-box > span {
            font-size: 22px;
            font-weight: bold;
            color: #a78bfa;
        }

        .level-info {
            width: 220px;
        }

        .level-info p {
            margin: 0 0 7px;
            color: #94a3b8;
            font-size: 12px;
            text-align: right;
        }

        .level-bar {
            width: 100%;
            height: 10px;
            background: #1e293b;
            border-radius: 10px;
            overflow: hidden;
        }

        .level-progress {
            height: 100%;
            border-radius: 10px;
            background: linear-gradient(90deg, #38bdf8, #8b5cf6);
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .stat-card {
            min-height: 130px;
            padding: 24px;
            background: #111d30;
            border: 1px solid #1e3a52;
            border-radius: 14px;
        }

        .stat-card p {
            margin: 0 0 18px;
            color: #94a3b8;
            font-size: 14px;
        }

        .stat-card h2 {
            margin: 0;
            font-size: 34px;
        }

        .stat-card.exp {
            border-color: #38bdf8;
        }

        .stat-card.exp h2 {
            color: #38bdf8;
        }
    </style>
</head>

<body>

<div class="dashboard">

    <aside class="sidebar">
        <h2>DEV HUNTER</h2>

        <nav>
            <p>Dashboard</p>
            <p>Quests</p>
            <p>Achievements</p>
        </nav>
    </aside>

    <main class="main-content">

        <header class="top-header">

            <div>
                <h1>DEV HUNTER</h1>
                <p>TURN YOUR COMMITS INTO LEGEND</p>
            </div>

            <div class="level-box">
                <span>LV.{{level.level}}</span>

                <div class="level-info">
                    <p>{{level.currentExp}} / 100 EXP</p>

                    <div class="level-bar">
                        <div class="level-progress"
                             style="width: {{level.progress}}%;"></div>
                    </div>
                </div>
            </div>

        </header>

        <section class="stats">

            <div class="stat-card">
                <p>오늘 커밋</p>
                <h2>{{summary.commitCount}}</h2>
            </div>

            <div class="stat-card">
                <p>추가된 코드</p>
                <h2>+{{summary.additions}}</h2>
            </div>

            <div class="stat-card">
                <p>삭제된 코드</p>
                <h2>-{{summary.deletions}}</h2>
            </div>

            <div class="stat-card exp">
                <p>오늘 획득 EXP</p>
                <h2>{{summary.exp}}</h2>
            </div>

        </section>

    </main>

</div>

</body>
</html>